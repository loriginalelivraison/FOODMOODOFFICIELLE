{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Backend: installer les dépendances Python",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Backend: vérifier Django",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"check"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Backend: appliquer les migrations",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"migrate",
				"--noinput"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Backend: lancer localhost",
			"type": "shell",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"runserver",
				"127.0.0.1:8000"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}