<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/offer_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="رحلة جديدة" android:textSize="12sp" android:textDirection="rtl" android:gravity="right|center_vertical" android:textAppearance="@style/TextAppearance.Compat.Notification" android:includeFontPadding="false" android:layout_weight="1" android:alpha="0.65"/>
        <TextView android:id="@+id/offer_price" android:layout_width="0dp" android:layout_height="wrap_content" android:text="دج" android:textSize="26sp" android:textDirection="rtl" android:gravity="right|center_vertical" android:textAppearance="@style/TextAppearance.Compat.Notification" android:includeFontPadding="false" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/offer_pickup" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 الانطلاق" android:textSize="13sp" android:textDirection="rtl" android:gravity="right|center_vertical" android:textAppearance="@style/TextAppearance.Compat.Notification" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/offer_destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏁 الوصول" android:textSize="13sp" android:textDirection="rtl" android:gravity="right|center_vertical" android:textAppearance="@style/TextAppearance.Compat.Notification" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/offer_accept" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@drawable/offer_accept" android:text="قبول" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/offer_reject" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:background="@drawable/offer_reject" android:text="رفض" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
